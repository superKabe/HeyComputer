<Application x:Class="HeyComputer.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#10131A" />
        <SolidColorBrush x:Key="PanelBackground" Color="#191E29" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB4C5" />
        <SolidColorBrush x:Key="Accent" Color="#75E6C8" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#293143" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="#3A465F" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#242B3A" />
            <Setter Property="Foreground" Value="#10131A" />
        </Style>
    </Application.Resources>
</Application>
