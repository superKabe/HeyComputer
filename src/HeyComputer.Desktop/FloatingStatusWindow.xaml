<Window x:Class="HeyComputer.Desktop.FloatingStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hey Computer status"
        Width="310"
        Height="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border x:Name="PanelBorder"
            Margin="6"
            Padding="14,12"
            Background="#F2191E29"
            BorderBrush="#4A566F"
            BorderThickness="1"
            CornerRadius="16"
            MouseLeftButtonUp="PanelBorder_OnMouseLeftButtonUp">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="StateDot"
                     Width="12"
                     Height="12"
                     Margin="0,3,11,0"
                     Fill="#8792A6"
                     VerticalAlignment="Top" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="StateText"
                           Text="Stopped"
                           Foreground="#F4F7FB"
                           FontWeight="SemiBold"
                           FontSize="14" />
                <TextBlock x:Name="ActivityText"
                           Text="No agent activity"
                           Margin="0,4,0,0"
                           Foreground="#AAB4C5"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Click to open dashboard"
                           Margin="0,3,0,0"
                           Foreground="#71809A"
                           FontSize="10" />
            </StackPanel>

            <Button Grid.Column="2"
                    Width="28"
                    Height="24"
                    Padding="0"
                    Margin="8,-4,-5,0"
                    Content="—"
                    ToolTip="Hide floating status"
                    Click="HideButton_OnClick" />
        </Grid>
    </Border>
</Window>
