<Window x:Class="HeyComputer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hey Computer"
        Width="620"
        Height="820"
        MinWidth="540"
        MinHeight="700"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Hey Computer" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Your local-first voice assistant for Windows."
                       Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryText}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,18"
                Padding="18"
                Background="{StaticResource PanelBackground}"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StateDot" Width="14" Height="14" Fill="#8792A6" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,18,0">
                    <TextBlock x:Name="StateText" Text="Stopped" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="RunningText"
                               Text="Assistant is stopped"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="PrivacyText"
                               Text="No microphone audio is being captured."
                               Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
                <ProgressBar x:Name="LevelMeter"
                             Grid.Column="2"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Microphone" FontWeight="SemiBold" />
            <ComboBox x:Name="MicrophonePicker"
                      Margin="0,8,0,20"
                      DisplayMemberPath="Name"
                      SelectionChanged="MicrophonePicker_OnSelectionChanged" />

            <TextBlock Text="Setup status" FontWeight="SemiBold" />
            <TextBlock x:Name="SetupStatusText"
                       Text="Loading local configuration…"
                       Margin="0,7,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryText}" />

            <TextBlock Text="xAI API key" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="Saved only in Windows Credential Manager. It is never written to app settings or logs."
                       Margin="0,7,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryText}" />
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Remove key" Click="RemoveApiKeyButton_OnClick" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Save key" Click="SaveApiKeyButton_OnClick" Margin="8,0,0,0" />
                <PasswordBox x:Name="ApiKeyBox"
                             Padding="8"
                             Background="#242B3A"
                             Foreground="{StaticResource PrimaryText}"
                             PasswordChar="●" />
            </DockPanel>

            <Border Margin="0,20,0,0"
                    Padding="16"
                    Background="{StaticResource PanelBackground}"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Computer control" FontWeight="SemiBold" />
                    <TextBlock Text="Local, allowlisted controls for the first hands-on prototype. Every action appears in Activity."
                               Margin="0,6,0,10"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryText}" />
                    <WrapPanel>
                        <Button Content="Play / pause media" Click="ToggleMediaButton_OnClick" />
                        <Button Content="Check Spotify" Click="CheckSpotifyButton_OnClick" />
                        <Button Content="Open Spotify" Click="OpenSpotifyButton_OnClick" />
                        <Button Content="Open YouTube" Click="OpenYouTubeButton_OnClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,20,0,0"
                    Padding="16"
                    Background="{StaticResource PanelBackground}"
                    CornerRadius="12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Agent topology" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="Preview · workers are not running"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="11" />
                    </DockPanel>

                    <Border Margin="90,12,90,0" Padding="12,8" Background="#253447" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Conversation Agent" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="Available · voice and personality layer"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="10,7" Background="#232A39" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Orchestration Agent" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Idle · delegates tasks" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="10,7" Background="#232A39" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Context Agent" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Idle · maintains local memory" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Padding="10,6" Background="#1E2430" CornerRadius="7">
                            <TextBlock Text="Worker slot 1 · empty" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                        </Border>
                        <Border Margin="8,0,0,0" Padding="10,6" Background="#1E2430" CornerRadius="7">
                            <TextBlock Text="Worker slot 2 · empty" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                        </Border>
                        <Border Margin="8,0,0,0" Padding="10,6" Background="#1E2430" CornerRadius="7">
                            <TextBlock Text="Worker slot 3 · empty" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="0,20,0,0"
                Padding="16"
                Height="150"
                Background="{StaticResource PanelBackground}"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="Activity" FontWeight="SemiBold" />
                    <TextBlock x:Name="ActivityHintText"
                               DockPanel.Dock="Right"
                               Text="Waiting for the assistant to start"
                               Foreground="{StaticResource SecondaryText}" />
                </DockPanel>
                <ListBox x:Name="ActivityList"
                         Grid.Row="1"
                         Margin="0,10,0,0"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource SecondaryText}"
                         IsHitTestVisible="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,22,0,0">
            <Button x:Name="StartButton" Content="Start listening" Click="StartButton_OnClick" />
            <Button x:Name="PushToTalkButton" Content="Push to talk" Click="PushToTalkButton_OnClick" IsEnabled="False" />
            <Button x:Name="MuteButton" Content="Mute" Click="MuteButton_OnClick" IsEnabled="False" />
            <Button x:Name="StopButton" Content="Stop" Click="StopButton_OnClick" IsEnabled="False" />
            <Button Content="Hide to tray" Click="HideButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
